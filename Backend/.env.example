# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/grocery-app

# Email settings (for real SMTP delivery; if not configured, the dev server will use Ethereal email previews)
SMTP_USER=
# If using Gmail, set SMTP_PASS to an app password, not your regular Gmail password.
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your@email.com

# Optional SendGrid SMTP credentials (preferred for production OTP delivery)
SENDGRID_API_KEY=
SENDGRID_SMTP_USER=apikey
SENDGRID_SMTP_PASS=
SENDGRID_SMTP_HOST=smtp.sendgrid.net
SENDGRID_SMTP_PORT=587
EMAIL_PROVIDER=sendgrid

# Frontend URL used in reset links and CORS
FRONTEND_URL=http://127.0.0.1:5173

# Node environment
NODE_ENV=development
