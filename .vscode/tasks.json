{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["run", "dev"],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}\\Backend"
			},
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Run Frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": ["run", "dev"],
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}\\Frontend"
			},
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Run Project",
			"dependsOn": [
				"Run Backend",
				"Run Frontend"
			],
			"dependsOrder": "sequence",
			"type": "shell",
			"command": "echo Project started",
			"problemMatcher": []
		}
	]
}